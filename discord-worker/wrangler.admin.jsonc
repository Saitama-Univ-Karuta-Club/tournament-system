{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sukc-tournament-admin",
  "main": "src/admin.ts",
  "compatibility_date": "2026-10-17",
  "observability": {
    "enabled": true
  },
  "vars": {
    "DOCUMENT_PUBLIC_BASE_URL": "https://sukc-tournament-discord-bot.saitama-univ-karuta-club.workers.dev",
    "DISCORD_GUILD_ID": "1534368058632572990",
    "DISCORD_REDIRECT_URI": "https://sukc-tournament-admin.saitama-univ-karuta-club.workers.dev/auth/discord/callback"
  },
  "access": {
    "dev": {
      "aud": "local-sukc-tournament-admin",
      "identity": {
        "email": "local-admin@example.invalid"
      }
    }
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sukc-tournament-discord-db",
      "database_id": "d1e159c8-0bc9-4065-a00b-15f8edd21d82",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "sukc-tournament-documents"
    }
  ],
  "services": [
    {
      "binding": "DOCUMENT_CONVERTER",
      "service": "sukc-tournament-backup",
      "entrypoint": "DocumentConverter"
    }
  ],
  "env": {
    "development": {
      "vars": {
        "ENVIRONMENT": "development",
        "DISCORD_APPLICATION_ID": "1563106568722063410",
        "DOCUMENT_PUBLIC_BASE_URL": "https://sukc-tournament-discord-bot-development.saitama-univ-karuta-club.workers.dev",
        "DISCORD_GUILD_ID": "1561041857952223352",
        "DISCORD_REDIRECT_URI": "https://sukc-tournament-admin-development.saitama-univ-karuta-club.workers.dev/auth/discord/callback"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "sukc-tournament-discord-db-development",
          "database_id": "86c04659-78f6-4bdb-909f-c7de05ad4246",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DOCUMENTS",
          "bucket_name": "sukc-tournament-documents-development"
        }
      ],
      "services": [
        {
          "binding": "DOCUMENT_CONVERTER",
          "service": "sukc-tournament-backup-development",
          "entrypoint": "DocumentConverter"
        }
      ]
    }
  }
}
