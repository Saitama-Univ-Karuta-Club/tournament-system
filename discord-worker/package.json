{
  "name": "sukc-tournament-discord-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:admin": "wrangler dev --config wrangler.admin.jsonc",
    "dev:portal": "wrangler dev --config wrangler.portal.jsonc",
    "dev:backup": "wrangler dev --config wrangler.backup.jsonc",
    "deploy": "wrangler deploy",
    "deploy:admin": "wrangler deploy --config wrangler.admin.jsonc",
    "deploy:portal": "wrangler deploy --config wrangler.portal.jsonc",
    "deploy:backup": "wrangler deploy --config wrangler.backup.jsonc",
    "deploy:development": "wrangler deploy --env development",
    "deploy:admin:development": "wrangler deploy --config wrangler.admin.jsonc --env development",
    "deploy:portal:development": "wrangler deploy --config wrangler.portal.jsonc --env development",
    "deploy:backup:development": "wrangler deploy --config wrangler.backup.jsonc --env development",
    "db:migrate:local": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:development": "wrangler d1 migrations apply DB --remote --env development",
    "register:commands": "tsx scripts/register-commands.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "discord-interactions": "4.4.0",
    "fflate": "^0.8.2"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "tsx": "latest",
    "typescript": "latest",
    "vitest": "^4.1.11",
    "wrangler": "latest"
  }
}
